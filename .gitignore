# STM32CubeIDE build output. Regenerated on build, and the generated makefiles
# bake in absolute paths, so sharing them breaks other machines.
/Debug/
/Release/

# Design notes kept locally, deliberately not published.
/docs/

# Auto-regenerated by the indexer on every build.
.settings/language.settings.xml

.DS_Store

# Eclipse workspace state - machine-specific, not project source.
/.metadata/

# Host test binaries (tools/Makefile).
/tools/soc_kf_test
/tools/lc_test
/tools/can_tx_test
/tools/rtd_test
/tools/adc_test
/tools/regen_test
/tools/regen_off_test
/tools/soc_derate_test
/tools/soc_derate_endurance_test
/tools/control_test
/tools/version_test
/tools/inv_tune_test
/tools/soc_kf_replay
/tools/*.dSYM/
/tools/cov/

# Generated by tools/version.sh on every build.
/Core/Inc/build_version.h

# CubeIDE macOS artifact.
/.osx.project
