 SG_ Inv_Cmd_Mode_State : 40|1@1+ (1,0) [0|1] "" AIM
 SG_ Inv_Rolling_Counter : 44|4@1+ (1,0) [0|15] "" AIM
 SG_ Inv_Enable_State : 48|1@1+ (1,0) [0|1] "" AIM
 SG_ Burst_Model_Mode : 49|1@1+ (1,0) [0|1] "" AIM
 SG_ Start_Mode_Active : 54|1@1+ (1,0) [0|1] "" AIM
 SG_ Inv_Enable_Lockout : 55|1@1+ (1,0) [0|1] "" AIM
 SG_ Inv_Direction : 56|1@1+ (1,0) [0|1] "" AIM
 SG_ BMS_Active : 57|1@1+ (1,0) [0|1] "" AIM
 SG_ BMS_Limiting_Torque : 58|1@1+ (1,0) [0|1] "" AIM
 SG_ Limit_Max_Speed : 59|1@1+ (1,0) [0|1] "" AIM
 SG_ Limit_Hot_Spot : 60|1@1+ (1,0) [0|1] "" AIM
 SG_ Low_Speed_Limiting : 61|1@1+ (1,0) [0|1] "" AIM
 SG_ Coolant_Temp_Limiting : 62|1@1+ (1,0) [0|1] "" AIM
 SG_ Limit_Stall_Burst : 63|1@1+ (1,0) [0|1] "" AIM

BO_ 172 INV_TorqueTimer: 8 INV
 SG_ Power_On_Timer : 32|32@1+ (0.003,0) [0|12884901.885] "s" AIM

BO_ 192 LVCU_InverterCmd: 8 LVCU
 SG_ Cmd_Rolling_Counter : 44|4@1+ (1,0) [0|15] "" AIM

BO_ 1365 LVCU_Debug: 8 LVCU
 SG_ RTD_Timeout : 0|8@1+ (1,0) [0|255] "" AIM

BO_ 1366 LVCU_Rtd: 2 LVCU
 SG_ RTD_Active : 0|1@1+ (1,0) [0|1] "" AIM
 SG_ Reset_Pin : 8|1@1+ (1,0) [0|1] "" AIM
 SG_ Reset_Power_On : 9|1@1+ (1,0) [0|1] "" AIM
 SG_ Reset_Software : 10|1@1+ (1,0) [0|1] "" AIM
 SG_ Reset_Watchdog : 11|1@1+ (1,0) [0|1] "" AIM

BO_ 1370 LVCU_SocDerate: 8 LVCU
 SG_ Derate_Tune : 0|8@1+ (1,0) [0|255] "" AIM
 SG_ DCL_Source : 8|1@1+ (1,0) [0|1] "" AIM
 SG_ DCL_Cell_Live : 9|1@1+ (1,0) [0|1] "" AIM
 SG_ DCL_Temp_Limited : 10|1@1+ (1,0) [0|1] "" AIM
 SG_ Active_DCL : 16|16@1+ (1,0) [0|65535] "A" AIM
 SG_ Weak_Cell_SOC : 32|16@1+ (0.01,0) [0|100] "%" AIM
 SG_ Cell_SOC_Gap : 48|16@1+ (0.01,0) [0|100] "%" AIM

