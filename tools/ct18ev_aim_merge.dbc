BO_ 1376 LVCU_InvTuneValue: 4 LVCU
 SG_ InvTune_Addr : 0|16@1+ (1,0) [0|65535] "" AIM
 SG_ InvTune_Value : 16|16@1+ (1,0) [0|65535] "" AIM

BO_ 1951 BMS_Cells: 8 BMS
 SG_ Low_Opencell_Voltage : 32|16@1+ (0.0001,0) [0|6.5535] "V" LVCU,AIM
 SG_ Avg_Opencell_Voltage : 48|16@1+ (0.0001,0) [0|6.5535] "V" LVCU,AIM

CM_ "Import into the CT-18EV RS3 protocol as of 2026-10-21. First delete the second 0xA2 stream (phase temps), the 0x557 stream and the 0x55A stream.";
CM_ BO_ 162 "Add to the existing 0xA2 stream (the coolant/hot spot/motor one)";
CM_ SG_ 162 Torque_Shudder "Shudder compensation torque";
CM_ BO_ 165 "Add to the existing 0xA5 stream";
CM_ SG_ 165 Motor_Angle "Electrical";
CM_ BO_ 170 "New stream. Internal states";
CM_ SG_ 170 Inv_Run_Mode_State "0 torque, 1 speed";
CM_ SG_ 170 Inv_Cmd_Mode_State "0 CAN, 1 VSM";
CM_ SG_ 170 Inv_Rolling_Counter "Value the inverter expects next";
CM_ SG_ 170 Burst_Model_Mode "0 stall, 1 high speed";
CM_ SG_ 170 Inv_Enable_Lockout "1 = cannot be enabled until a disable command is seen";
CM_ SG_ 170 Inv_Direction "1 forward";
CM_ BO_ 172 "Add to the existing 0xAC stream";
CM_ SG_ 172 Power_On_Timer "Since the inverter powered up";
CM_ BO_ 192 "Add to the existing 0xC0 stream";
CM_ SG_ 192 Cmd_Rolling_Counter "Heartbeat the inverter checks, should count 0-15 without gaps";
CM_ BO_ 1365 "Add to the existing 0x555 stream";
CM_ SG_ 1365 RTD_Timeout "90 ms ticks since the inverter ready pin was last seen, capped";
CM_ BO_ 1366 "New stream. Ready to drive and why the LVCU last reset";
CM_ SG_ 1366 Reset_Software "Error_Handler";
CM_ BO_ 1370 "Replaces the existing 0x55A stream, which has the old layout. SoC derate. RS3 had an old layout (SoC/Cell/Active DCL as bytes 2-4), this is the firmware's";
CM_ SG_ 1370 DCL_Source "0 = BMS DCL, 1 = SoC curve";
CM_ SG_ 1370 DCL_Temp_Limited "1 = pack temp curve set Active_DCL";
CM_ BO_ 1372 "Add to the existing 0x55C stream";
CM_ SG_ 1372 BPS_ADC "Raw 12 bit ADC";
CM_ BO_ 1373 "New stream. Inverter EEPROM readback status. Bytes 1, 3 and 6 (read count, sweeps, parameter count) are left out to save AiM channels";
CM_ SG_ 1373 InvTune_State "0 no inverter, 1 settling, 2 reading, 3 paused (inverter enabled), 4 done";
CM_ SG_ 1373 InvTune_CRC "CRC-16/CCITT-FALSE of all 92 values, little endian, table order. inv_tune_decode.py checks against it";
CM_ BO_ 1376 "New stream. One inverter EEPROM parameter per frame, cycling through the table in inv_tune_params.h. Log at 20 Hz or faster and decode with tools/inv_tune_decode.py";
CM_ SG_ 1376 InvTune_Addr "Inverter CAN parameter address";
CM_ SG_ 1376 InvTune_Value "Raw 16 bit value, scaling per parameter. 0x8000 = not read";
CM_ BO_ 1951 "Add to the existing 0x79F stream";
CM_ SG_ 1951 Low_Opencell_Voltage "Used by the SoC derate";
CM_ SG_ 1951 Avg_Opencell_Voltage "Used by the SoC derate";

BA_DEF_ BO_ "GenMsgCycleTime" INT 0 65535;
BA_DEF_DEF_ "GenMsgCycleTime" 0;
BA_ "GenMsgCycleTime" BO_ 162 100;
BA_ "GenMsgCycleTime" BO_ 165 5;
BA_ "GenMsgCycleTime" BO_ 170 5;
BA_ "GenMsgCycleTime" BO_ 172 5;
BA_ "GenMsgCycleTime" BO_ 192 5;
BA_ "GenMsgCycleTime" BO_ 1365 90;
BA_ "GenMsgCycleTime" BO_ 1366 90;
BA_ "GenMsgCycleTime" BO_ 1370 90;
BA_ "GenMsgCycleTime" BO_ 1372 50;
BA_ "GenMsgCycleTime" BO_ 1373 40;
BA_ "GenMsgCycleTime" BO_ 1376 40;

VAL_ 170 VSM_State 0 "Start" 1 "Precharge init" 2 "Precharge active" 3 "Precharge complete" 4 "Wait" 5 "Ready" 6 "Motor running" 7 "Blink fault code" 14 "Shutdown in process" 15 "Recycle power" ;
VAL_ 170 Inverter_State 0 "Power on" 1 "Stop" 2 "Open loop" 3 "Closed loop" 4 "Wait" 8 "Idle run" 9 "Idle stop" ;
VAL_ 170 Active_Discharge_State 0 "Disabled" 1 "Enabled, waiting" 2 "Speed check" 3 "Discharging" 4 "Complete" ;
VAL_ 1370 DCL_Source 0 "BMS" 1 "SoC" ;
VAL_ 1373 InvTune_State 0 "No inverter" 1 "Settling" 2 "Reading" 3 "Paused" 4 "Done" ;
