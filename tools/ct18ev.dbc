CM_ "CT-18EV CAN as logged by the AiM once ct18ev_aim_merge.dbc is in. Everything on the bus except 0x0C1/0x0C2 (covered by the tune frames) and 0x300 (the AiM own wheel speed).";
CM_ BO_ 162 "Temperatures #3";
CM_ SG_ 162 Torque_Shudder "Shudder compensation torque";
CM_ BO_ 165 "Motor position";
CM_ SG_ 165 Motor_Angle "Electrical";
CM_ BO_ 166 "Current information";
CM_ BO_ 168 "Flux information";
CM_ BO_ 170 "Internal states";
CM_ SG_ 170 Inv_Run_Mode_State "0 torque, 1 speed";
CM_ SG_ 170 Inv_Cmd_Mode_State "0 CAN, 1 VSM";
CM_ SG_ 170 Inv_Rolling_Counter "Value the inverter expects next";
CM_ SG_ 170 Burst_Model_Mode "0 stall, 1 high speed";
CM_ SG_ 170 Inv_Enable_Lockout "1 = cannot be enabled until a disable command is seen";
CM_ SG_ 170 Inv_Direction "1 forward";
CM_ BO_ 171 "POST faults bytes 0-3, run faults bytes 4-7";
CM_ BO_ 172 "Torque and timer";
CM_ SG_ 172 Power_On_Timer "Since the inverter powered up";
CM_ BO_ 177 "Torque capability";
CM_ BO_ 192 "Torque command to the inverter";
CM_ SG_ 192 Direction_Cmd "1 = forward";
CM_ SG_ 192 Cmd_Rolling_Counter "Heartbeat the inverter checks, should count 0-15 without gaps";
CM_ BO_ 514 "Orion custom message";
CM_ BO_ 1365 "Pedal and interlock debug";
CM_ SG_ 1365 RTD_Timeout "90 ms ticks since the inverter ready pin was last seen, capped";
CM_ SG_ 1365 BSE_Voltage "Brake sensor at the ADC pin, top 8 of 12 bits";
CM_ SG_ 1365 TPS_1_Voltage "TPS1 at the ADC pin, top 8 of 12 bits";
CM_ SG_ 1365 TPS_2_Voltage "TPS2 at the ADC pin, top 8 of 12 bits";
CM_ SG_ 1365 LVCU_Status "Bit field: 0 disable cmd, 1 ready to drive, 2 BSE fault, 3 TPS1 out of range, 4 TPS2 out of range, 5 TPS disagree, 6 inverter enabled, 7 inverter lockout";
CM_ BO_ 1366 "Ready to drive and why the LVCU last reset";
CM_ SG_ 1366 Reset_Software "Error_Handler";
CM_ BO_ 1368 "SoC estimator state";
CM_ SG_ 1368 Innovation "Measured minus predicted cell voltage";
CM_ SG_ 1368 Loop_dt_Max "Longest control loop since boot";
CM_ BO_ 1370 "SoC derate. RS3 had an old layout (SoC/Cell/Active DCL as bytes 2-4), this is the firmware's";
CM_ SG_ 1370 DCL_Source "0 = BMS DCL, 1 = SoC curve";
CM_ SG_ 1370 DCL_Temp_Limited "1 = pack temp curve set Active_DCL";
CM_ BO_ 1371 "Firmware git hash, see tools/find_build.sh";
CM_ SG_ 1371 Version_Flags "Bit 0 uncommitted changes, bit 1 no git info";
CM_ BO_ 1372 "Brake pressure";
CM_ SG_ 1372 BPS_ADC "Raw 12 bit ADC";
CM_ BO_ 1373 "Inverter EEPROM readback status. Bytes 1, 3 and 6 (read count, sweeps, parameter count) are left out to save AiM channels";
CM_ SG_ 1373 InvTune_State "0 no inverter, 1 settling, 2 reading, 3 paused (inverter enabled), 4 done";
CM_ SG_ 1373 InvTune_CRC "CRC-16/CCITT-FALSE of all 92 values, little endian, table order. inv_tune_decode.py checks against it";
CM_ BO_ 1376 "One inverter EEPROM parameter per frame, cycling through the table in inv_tune_params.h. Log at 20 Hz or faster and decode with tools/inv_tune_decode.py";
CM_ SG_ 1376 InvTune_Addr "Inverter CAN parameter address";
CM_ SG_ 1376 InvTune_Value "Raw 16 bit value, scaling per parameter. 0x8000 = not read";
CM_ BO_ 1536 "Orion custom message";
CM_ SG_ 1536 BMS_Bit0 "Name truncated to 'BMS' in RS3, copy it from there";
CM_ SG_ 1536 BMS_LV_Input "Gain not visible in RS3 screenshot, copy it from RS3";
CM_ BO_ 1951 "Orion custom message";
CM_ SG_ 1951 Min_Cell_Voltage "Gain not visible in RS3 screenshot, copy it from RS3";
CM_ SG_ 1951 Low_Opencell_Voltage "Used by the SoC derate";
CM_ SG_ 1951 Avg_Opencell_Voltage "Used by the SoC derate";

