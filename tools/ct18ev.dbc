VAL_ 170 VSM_State 0 "Start" 1 "Precharge init" 2 "Precharge active" 3 "Precharge complete" 4 "Wait" 5 "Ready" 6 "Motor running" 7 "Blink fault code" 14 "Shutdown in process" 15 "Recycle power" ;
VAL_ 170 Inverter_State 0 "Power on" 1 "Stop" 2 "Open loop" 3 "Closed loop" 4 "Wait" 8 "Idle run" 9 "Idle stop" ;
VAL_ 170 Active_Discharge_State 0 "Disabled" 1 "Enabled, waiting" 2 "Speed check" 3 "Discharging" 4 "Complete" ;
VAL_ 1370 DCL_Source 0 "BMS" 1 "SoC" ;
VAL_ 1373 InvTune_State 0 "No inverter" 1 "Settling" 2 "Reading" 3 "Paused" 4 "Done" ;
